<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1180.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.research_project.controller.MainController">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="230.0" spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets bottom="16.0" left="14.0" right="14.0" top="18.0" />
            </padding>

            <!-- App Logo & Branding -->
            <VBox spacing="4.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-size: 22px;" text="🔬" />
                    <VBox spacing="1.0">
                        <Label styleClass="sidebar-title" text="AI Research" />
                        <Label styleClass="sidebar-subtitle" text="Smart Paper Assistant" />
                    </VBox>
                </HBox>
            </VBox>

            <Separator opacity="0.15" />

            <!-- Navigation Links -->
            <VBox spacing="6.0">
                <Label styleClass="sidebar-section-header" text="NAVIGATION" />

                <Button fx:id="btnDashboard" maxWidth="1.7976931348623157E308" onAction="#showDashboard"
                        styleClass="nav-button" text="📊  Dashboard" />

                <Button fx:id="btnPapers" maxWidth="1.7976931348623157E308" onAction="#showPapers"
                        styleClass="nav-button" text="📚  Papers Library" />

                <Button fx:id="btnAddPaper" maxWidth="1.7976931348623157E308" onAction="#showAddPaper"
                        styleClass="nav-button" text="➕  Add Paper" />

                <Button fx:id="btnAnalysis" maxWidth="1.7976931348623157E308" onAction="#showAnalysis"
                        styleClass="nav-button" text="⚡  Analysis &amp; AI" />

                <Button fx:id="btnSearch" maxWidth="1.7976931348623157E308" onAction="#showSearch"
                        styleClass="nav-button" text="🔍  Search &amp; Filter" />

                <Label styleClass="sidebar-section-header" text="EXTRAS" />

                <Button fx:id="btnFavorites" maxWidth="1.7976931348623157E308" onAction="#showFavorites"
                        styleClass="nav-button" text="⭐  Favorites" />

                <Button fx:id="btnCompare" maxWidth="1.7976931348623157E308" onAction="#showComparison"
                        styleClass="nav-button" text="⚖️  Compare Papers" />

                <Button fx:id="btnReports" maxWidth="1.7976931348623157E308" onAction="#showReports"
                        styleClass="nav-button" text="📑  Research Reports" />

                <Label styleClass="sidebar-section-header" text="PREFERENCES" />

                <Button fx:id="btnSettings" maxWidth="1.7976931348623157E308" onAction="#showSettings"
                        styleClass="nav-button" text="⚙️  Settings" />
            </VBox>

            <!-- Spacer pushes footer to bottom -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Quick Theme Switcher Button in Sidebar -->
            <Button fx:id="btnThemeToggle" maxWidth="1.7976931348623157E308" onAction="#onToggleTheme"
                    styleClass="theme-switch-btn" text="☀️  Light Mode" />

            <!-- Sidebar Footer Status Box -->
            <VBox spacing="6.0" styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label styleClass="status-dot" text="●" />
                    <Label styleClass="sidebar-footer-text" text="SQLite &amp; Ollama" />
                </HBox>
                <Label styleClass="sidebar-footer-subtext" text="JavaFX 21 + org.json" />
            </VBox>
        </VBox>
    </left>

    <!-- Main Dynamic Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content" BorderPane.alignment="CENTER" />
    </center>

</BorderPane>
