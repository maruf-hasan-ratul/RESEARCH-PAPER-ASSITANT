<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.research_project.controller.MainController">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="230.0" spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets bottom="16.0" left="14.0" right="14.0" top="18.0" />
            </padding>

            <!-- App Logo & Branding -->
            <VBox spacing="4.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-size: 22px;" text="🔬" />
                    <VBox spacing="1.0">
                        <Label styleClass="sidebar-title" text="AI Research" />
                        <Label styleClass="sidebar-subtitle" text="Smart Paper Assistant" />
                    </VBox>
                </HBox>
                <Label style="-fx-font-size: 10px; -fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-padding: 3 0 0 0;"
                       text="OOP UNIVERSITY PROJECT" />
            </VBox>

            <Separator opacity="0.15" />

            <!-- Navigation Links -->
            <VBox spacing="6.0">
                <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B; -fx-font-weight: bold; -fx-padding: 6 8 2 8;"
                       text="NAVIGATION" />

                <Button fx:id="btnDashboard" maxWidth="1.7976931348623157E308" onAction="#showDashboard"
                        styleClass="nav-button" text="📊  Dashboard" />

                <Button fx:id="btnPapers" maxWidth="1.7976931348623157E308" onAction="#showPapers"
                        styleClass="nav-button" text="📚  Papers Library" />

                <Button fx:id="btnAddPaper" maxWidth="1.7976931348623157E308" onAction="#showAddPaper"
                        styleClass="nav-button" text="➕  Add Paper" />

                <Button fx:id="btnAnalysis" maxWidth="1.7976931348623157E308" onAction="#showAnalysis"
                        styleClass="nav-button" text="⚡  Analysis &amp; AI" />

                <Button fx:id="btnSearch" maxWidth="1.7976931348623157E308" onAction="#showSearch"
                        styleClass="nav-button" text="🔍  Search &amp; Filter" />
            </VBox>

            <!-- Spacer pushes footer to bottom -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Sidebar Footer -->
            <VBox spacing="6.0" style="-fx-background-color: #1E293B; -fx-padding: 10; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label style="-fx-text-fill: #10B981; -fx-font-size: 10px;" text="●" />
                    <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold;" text="SQLite &amp; Ollama" />
                </HBox>
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 10px;" text="JavaFX 21 + org.json" />
            </VBox>
        </VBox>
    </left>

    <!-- Main Dynamic Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content" BorderPane.alignment="CENTER" />
    </center>

</BorderPane>
