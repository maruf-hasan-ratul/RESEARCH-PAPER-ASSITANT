<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.research_project.controller.SearchController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <!-- Top Header -->
    <VBox spacing="3.0">
        <Label styleClass="page-header-title" text="🔍 Advanced Search &amp; Filter" />
        <Label styleClass="page-header-desc" text="Search across titles, authors, extracted keywords, reading statuses, and bookmarks." />
    </VBox>

    <!-- Search & Filter Controls Card -->
    <VBox spacing="14.0" styleClass="card">
        <!-- Row 1: Search Query -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="filter-label" text="SEARCH KEYWORD / TITLE / AUTHOR" />
                <TextField fx:id="searchField" onAction="#onSearch" promptText="Enter query term (e.g. neural network, transformer, author name)..." />
            </VBox>

            <VBox alignment="BOTTOM_CENTER" spacing="4.0">
                <HBox spacing="8.0">
                    <Button onAction="#onSearch" styleClass="btn-primary" text="🔍 Search" />
                    <Button onAction="#onReset" styleClass="btn-secondary" text="Clear Filters" />
                </HBox>
            </VBox>
        </HBox>

        <!-- Row 2: Filtering ComboBoxes -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <!-- Category Filter -->
            <VBox prefWidth="200.0" spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="filter-label" text="CATEGORY" />
                <ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308" />
            </VBox>

            <!-- Reading Status Filter -->
            <VBox prefWidth="160.0" spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="filter-label" text="READING STATUS" />
                <ComboBox fx:id="statusCombo" maxWidth="1.7976931348623157E308" />
            </VBox>

            <!-- Year Filter -->
            <VBox prefWidth="120.0" spacing="4.0">
                <Label styleClass="filter-label" text="YEAR" />
                <ComboBox fx:id="yearCombo" maxWidth="1.7976931348623157E308" />
            </VBox>

            <!-- Favorites Filter -->
            <VBox prefWidth="140.0" spacing="4.0">
                <Label styleClass="filter-label" text="BOOKMARKS" />
                <ComboBox fx:id="favoriteCombo" maxWidth="1.7976931348623157E308" />
            </VBox>
        </HBox>
    </VBox>

    <!-- Results Table Card -->
    <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblResultCount" styleClass="card-title" text="Results" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10.0">
                <Button onAction="#onView" styleClass="btn-secondary" text="👁️ View Details" />
                <Button onAction="#onAnalyse" styleClass="btn-primary" text="⚡ Analyse" />
            </HBox>
        </HBox>

        <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colFavorite" prefWidth="45.0" text="Fav" />
                <TableColumn fx:id="colTitle" prefWidth="320.0" text="Title" />
                <TableColumn fx:id="colAuthors" prefWidth="200.0" text="Authors" />
                <TableColumn fx:id="colYear" prefWidth="70.0" text="Year" />
                <TableColumn fx:id="colCategory" prefWidth="150.0" text="Category" />
                <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label styleClass="tip-label" text="Tip: Double-click any row to view its full details and citations." />
    </VBox>

</VBox>
